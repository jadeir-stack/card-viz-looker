      },
      {
        "id": "produto",
        "name": "Produto",
        "type": "TEXT"
      },
      {
        "id": "descricao",
        "name": "Descrição",
        "type": "TEXT"
      },
      {
        "id": "total_anual",
        "name": "Total Anual",
        "type": "NUMBER"
      },
      {
        "id": "total_mensal",
        "name": "Total Mensal",
        "type": "NUMBER"
      }
    ]
  },

  "style": [
    {
      "id": "qtd_cards",
      "name": "Quantidade de Cards",
      "type": "NUMBER",
      "defaultValue": 10
    },
    {
      "id": "ordenar_por",
      "name": "Ordenar por",
      "type": "TEXTINPUT",
      "defaultValue": "total_anual"
    },
    {
      "id": "ordem",
      "name": "Ordem (asc/desc)",
      "type": "TEXTINPUT",
      "defaultValue": "desc"
